*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/
ENV/

# Python packaging and build output
.Python
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Test and coverage output
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Type-checker and linter caches
.mypy_cache/
.pyre/
