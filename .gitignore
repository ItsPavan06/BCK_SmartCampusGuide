# Local environment and secrets
.env
.env.*
!.env.example

# Local databases and generated runtime data
*.db
*.sqlite
*.sqlite3

# Logs
*.log

# IDE and editor files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo

# OS trash
.Trashes/
